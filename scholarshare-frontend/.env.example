# Copy this file to ".env" and adjust.

# Base URL of the Spring Boot API.
#   "/api"  -> goes through the Vite dev proxy (vite.config.js -> http://localhost:8080)
#   or a full URL for a deployed backend, e.g. https://api.scholarshare.com/api
VITE_API_BASE_URL=/api

# Google sign-in: the OAuth "Web client" id from Google Cloud Console (same value as GOOGLE_CLIENT_ID on the backend).
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
